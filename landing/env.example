# Skerry Landing — environment template.
# Real values live in Cloudflare Pages → Settings → Environment Variables.
# Never commit a populated .env file.

# Public origin used in canonical URLs / emails.
PUBLIC_SITE_URL="https://skerry.cloud"

# --- Supabase (waitlist storage) -------------------------------------------
# Use the *service role* key — only on the server.
SUPABASE_URL="https://<project>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# --- Resend (confirmation emails) ------------------------------------------
RESEND_API_KEY=""
# Verified sender. Must match a domain you've authenticated in Resend.
RESEND_FROM_EMAIL="hello@skerry.cloud"
RESEND_REPLY_TO="hello@skerry.cloud"

# --- Stripe (founding member deposit) --------------------------------------
# Use sk_live_… in production, sk_test_… in preview deploys.
STRIPE_SECRET_KEY=""
# Returned from `stripe listen` (dev) or the live webhook endpoint.
STRIPE_WEBHOOK_SECRET=""
# Pre-created Price ID for the €19 founding deposit (one-time).
STRIPE_FOUNDING_PRICE_ID=""

# --- Anti-abuse -------------------------------------------------------------
# Optional: simple shared secret rotation handle for admin endpoints.
ADMIN_API_TOKEN=""
