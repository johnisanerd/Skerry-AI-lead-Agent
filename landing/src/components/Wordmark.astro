---
/**
 * Skerry brand wordmark — "Skerry LeadGen ⬡S".
 *
 * The logo replaces the "O" in "OS" so the product name reads as one
 * cohesive shape rather than icon-plus-text. Sizes use em so the icon
 * scales with whatever font-size the parent sets.
 */
interface Props {
  size?: "sm" | "md" | "lg" | "xl";
  class?: string;
  /**
   * Mobile-friendly fallback. When true, the "LeadGen" middle word is
   * hidden under sm breakpoints so the wordmark stays readable in tight
   * nav bars: "Skerry ⬡S".
   */
  collapseOnMobile?: boolean;
}

const {
  size = "md",
  class: className = "",
  collapseOnMobile = false,
} = Astro.props;

const sizeClass = {
  sm: "text-base",
  md: "text-xl",
  lg: "text-3xl",
  xl: "text-5xl sm:text-6xl",
}[size];
---

<span
  class:list={[
    "inline-flex items-center gap-x-[0.28em] font-semibold tracking-tight leading-none [color:var(--fg)]",
    sizeClass,
    className,
  ]}
>
  <span>Skerry</span>
  <span class:list={[collapseOnMobile && "hidden sm:inline"]}>LeadGen</span>
  <span class="inline-flex items-center">
    <img
      src="/logo.png"
      alt=""
      aria-hidden="true"
      class="h-[1.7em] w-[1.7em] select-none drop-shadow-[0_0_13px_rgba(167,139,250,1)] drop-shadow-[0_0_36px_rgba(167,139,250,0.7)] drop-shadow-[0_0_60px_rgba(167,139,250,0.35)]"
      width="48"
      height="48"
    />
    <span class="-ml-[0.4em]">S</span>
  </span>
</span>
