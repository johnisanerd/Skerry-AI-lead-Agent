---
/**
 * Skerry brand wordmark — "Skerry LeadGen ⬡S".
 *
 * The logo replaces the "O" in "OS" so the product name reads as one
 * cohesive shape rather than icon-plus-text. Sizes use em so the icon
 * scales with whatever font-size the parent sets.
 */
interface Props {
  size?: "sm" | "md" | "lg" | "xl";
  class?: string;
  /**
   * Mobile-friendly fallback. When true, the "LeadGen" middle word is
   * hidden under sm breakpoints so the wordmark stays readable in tight
   * nav bars: "Skerry ⬡S".
   */
  collapseOnMobile?: boolean;
}

const {
  size = "md",
  class: className = "",
  collapseOnMobile = false,
} = Astro.props;

const sizeClass = {
  sm: "text-sm",
  md: "text-base",
  lg: "text-2xl",
  xl: "text-4xl sm:text-5xl",
}[size];
---

<span
  class:list={[
    "inline-flex items-center gap-x-1.5 font-semibold tracking-tight text-white leading-none",
    sizeClass,
    className,
  ]}
>
  <span>Skerry</span>
  <span class:list={[collapseOnMobile && "hidden sm:inline"]}>LeadGen</span>
  <span class="inline-flex items-center gap-x-[0.06em]">
    <img
      src="/logo.png"
      alt=""
      aria-hidden="true"
      class="h-[1.7em] w-[1.7em] select-none drop-shadow-[0_0_8px_rgba(167,139,250,0.9)] drop-shadow-[0_0_24px_rgba(167,139,250,0.55)]"
      width="48"
      height="48"
    />
    <span>S</span>
  </span>
</span>
