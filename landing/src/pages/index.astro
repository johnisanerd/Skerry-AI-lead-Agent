---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import WaitlistForm from "@/components/WaitlistForm.tsx";
import FoundingDepositCTA from "@/components/FoundingDepositCTA.tsx";
import LeadPulse from "@/components/LeadPulse.tsx";
import AgentDemo from "@/components/AgentDemo.tsx";
import { detectLang, t, type StringKey } from "@/lib/i18n";

const lang = detectLang(Astro.request);

const steps = (
  [
    { n: "01", titleKey: "how.s1.title", bodyKey: "how.s1.body" },
    { n: "02", titleKey: "how.s2.title", bodyKey: "how.s2.body" },
    { n: "03", titleKey: "how.s3.title", bodyKey: "how.s3.body" },
    { n: "04", titleKey: "how.s4.title", bodyKey: "how.s4.body" },
  ] as const
);

interface Plan {
  name: string;
  whoKey:
    | "plans.solo.who"
    | "plans.team.who"
    | "plans.agency.who"
    | "plans.enterprise.who";
  price: string;
  priceNote?: string;
  highlight: boolean;
  isEnterprise?: boolean;
  features: string[];
}

const plans: Plan[] = [
  {
    name: "Solo",
    whoKey: "plans.solo.who",
    price: "€49",
    highlight: false,
    features: [
      `5 ${t(lang, "plans.feat.runs")}`,
      `25 ${t(lang, "plans.feat.leads")}`,
      "Apollo + GPT",
      "CSV export",
    ],
  },
  {
    name: "Team",
    whoKey: "plans.team.who",
    price: "€149",
    highlight: true,
    features: [
      `20 ${t(lang, "plans.feat.runs")}`,
      `100 ${t(lang, "plans.feat.leads")}`,
      "Push to Instantly",
      "Multi-ICP",
    ],
  },
  {
    name: "Agency",
    whoKey: "plans.agency.who",
    price: "€399",
    highlight: false,
    features: [
      t(lang, "plans.feat.unlimited"),
      `500 ${t(lang, "plans.feat.leads")}`,
      "White-label",
      "Priority support",
    ],
  },
  {
    name: "Enterprise",
    whoKey: "plans.enterprise.who",
    price: t(lang, "plans.enterprise.priceLabel"),
    priceNote: t(lang, "plans.enterprise.priceNote"),
    highlight: false,
    isEnterprise: true,
    features: [
      t(lang, "plans.feat.seats"),
      t(lang, "plans.feat.sso"),
      t(lang, "plans.feat.sla"),
      t(lang, "plans.feat.am"),
      t(lang, "plans.feat.api"),
    ],
  },
];

const faqItems = (
  [
    { qKey: "faq.q1", aKey: "faq.a1" },
    { qKey: "faq.q2", aKey: "faq.a2" },
    { qKey: "faq.q3", aKey: "faq.a3" },
    { qKey: "faq.q4", aKey: "faq.a4" },
    { qKey: "faq.q5", aKey: "faq.a5" },
    { qKey: "faq.q6", aKey: "faq.a6" },
  ] as const
);

interface EnterpriseCard {
  icon: "shield" | "support" | "integration";
  titleKey: StringKey;
  bodyKey: StringKey;
}

const enterpriseCards: EnterpriseCard[] = [
  {
    icon: "shield",
    titleKey: "enterprise.security.title",
    bodyKey: "enterprise.security.body",
  },
  {
    icon: "support",
    titleKey: "enterprise.support.title",
    bodyKey: "enterprise.support.body",
  },
  {
    icon: "integration",
    titleKey: "enterprise.integration.title",
    bodyKey: "enterprise.integration.body",
  },
];
---

<Layout>
  <Header lang={lang} />

  <!-- HERO -->
  <section
    id="waitlist"
    class="mx-auto max-w-6xl px-6 pb-20 pt-12 sm:pt-20 lg:pt-24"
  >
    <div class="grid items-center gap-10 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
      <div>
        <span class="eyebrow">{t(lang, "hero.eyebrow")}</span>
        <h1
          class="heading mt-5 text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl"
        >
          {t(lang, "hero.title.before")}
          <span class="text-gradient-brand">{t(lang, "hero.title.accent")}</span>
        </h1>
        <p class="body-text mt-6 max-w-2xl text-lg leading-relaxed">
          {t(lang, "hero.subtitle")}
        </p>

        <div class="mt-8 max-w-xl">
          <WaitlistForm
            client:load
            ctaLabel={t(lang, "form.submit")}
            placeholder={t(lang, "form.placeholder")}
            successCopyNew={t(lang, "form.success.copy.new")}
            successCopyDup={t(lang, "form.success.copy.dup")}
            successTitle={t(lang, "form.success.title")}
            successCta={t(lang, "form.success.cta")}
            successNote={t(lang, "form.success.note")}
            errorGeneric={t(lang, "form.error.generic")}
          />
        </div>

        <div
          class="muted-text mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs"
        >
          {[
            t(lang, "hero.badge.gdpr"),
            t(lang, "hero.badge.apollo"),
            t(lang, "hero.badge.instantly"),
            t(lang, "hero.badge.soc2"),
            t(lang, "hero.badge.iso27001"),
          ].map((label) => (
            <span class="flex items-center gap-2">
              <svg
                class="h-3.5 w-3.5 text-brand-500 dark:text-brand-400"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M5 12l5 5L20 7"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              {label}
            </span>
          ))}
        </div>
      </div>

      <div class="flex justify-center lg:justify-end">
        <LeadPulse client:load />
      </div>
    </div>
  </section>

  <!-- DEMO BLOCK -->
  <section id="demo" class="mx-auto max-w-6xl px-6 pb-24 pt-8">
    <div class="mb-10 text-center">
      <span class="eyebrow inline-flex items-center gap-1.5">
        <svg
          viewBox="0 0 24 24"
          class="h-3.5 w-3.5"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M13 2 4 14h6l-1 8 9-12h-6l1-8Z" />
        </svg>
        {t(lang, "demo.eyebrow")}
      </span>
      <h2
        class="heading mx-auto mt-4 max-w-3xl text-3xl font-bold tracking-tight sm:text-5xl"
      >
        {t(lang, "demo.title.before")}
        <span class="text-gradient-brand">{t(lang, "demo.title.accent")}</span>
      </h2>
      <p class="body-text mx-auto mt-4 max-w-2xl text-base leading-relaxed">
        {t(lang, "demo.subtitle")}
      </p>
    </div>

    <AgentDemo
      client:load
      url={t(lang, "demo.url")}
      icp={t(lang, "demo.icp")}
      contactsLabel={t(lang, "demo.contacts")}
      stageInputLabel={t(lang, "demo.stage.input")}
      stageResearchLabel={t(lang, "demo.stage.research")}
      stageDraftLabel={t(lang, "demo.stage.draft")}
      stageSendLabel={t(lang, "demo.stage.send")}
      stageDoneLabel={t(lang, "demo.stage.done")}
      resultsTitle={t(lang, "demo.results.title")}
      resultsSuffix={t(lang, "demo.results.suffix")}
      resultsCount={t(lang, "demo.results.count")}
      matchLabel={t(lang, "demo.results.match")}
      viewAllLabel={t(lang, "demo.viewall")}
      emailSubject={t(lang, "demo.email.subject")}
      emailBody={t(lang, "demo.email.body")}
      sentViaLabel={t(lang, "demo.email.sentvia")}
    />
  </section>

  <!-- HOW IT WORKS -->
  <section id="features" class="mx-auto max-w-6xl px-6 pb-24">
    <div class="mb-12 max-w-2xl">
      <span class="eyebrow">{t(lang, "how.eyebrow")}</span>
      <h2 class="heading mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
        {t(lang, "how.title")}
      </h2>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((step) => (
        <div class="panel flex flex-col p-5">
          <div class="text-[11px] font-semibold tracking-[0.22em] text-brand-500 dark:text-brand-300/80">
            {step.n}
          </div>
          <h3 class="heading mt-2 text-base font-semibold">
            {t(lang, step.titleKey)}
          </h3>
          <p class="muted-text mt-2 text-sm leading-relaxed">
            {t(lang, step.bodyKey)}
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- FOUNDING OFFER -->
  <section id="founding" class="mx-auto max-w-6xl px-6 pb-24">
    <div
      class="grid gap-8 rounded-3xl border p-8 lg:grid-cols-2 lg:p-12"
      style="border-color: rgba(167,139,250,0.25); background: linear-gradient(135deg, rgba(139,92,246,0.06), rgba(196,181,253,0.02));"
    >
      <div>
        <span class="eyebrow">{t(lang, "found.eyebrow")}</span>
        <h2 class="heading mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
          {t(lang, "found.title.before")}
          <span class="text-gradient-brand">
            {t(lang, "found.title.accent")}
          </span>
          {t(lang, "found.title.after")}
        </h2>
        <p class="body-text mt-4 text-base leading-relaxed">
          {t(lang, "found.body")}
        </p>
        <ul class="body-text mt-6 space-y-2.5 text-sm">
          {[
            t(lang, "found.bullet.1"),
            t(lang, "found.bullet.2"),
            t(lang, "found.bullet.3"),
            t(lang, "found.bullet.4"),
          ].map((line) => (
            <li class="flex items-start gap-2.5">
              <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500 dark:bg-brand-400" />
              {line}
            </li>
          ))}
        </ul>
      </div>
      <div class="panel flex flex-col justify-center p-6 lg:p-8">
        <div
          class="text-[11px] uppercase tracking-[0.22em] text-brand-500 dark:text-brand-300/80"
        >
          {t(lang, "found.card.title")}
        </div>
        <div class="mt-2 flex items-baseline gap-2">
          <span class="heading text-5xl font-bold">€19</span>
          <span class="muted-text text-sm">
            {t(lang, "found.card.priceNote")}
          </span>
        </div>
        <p class="muted-text mt-4 text-xs">{t(lang, "found.card.foot")}</p>
        <div class="mt-6">
          <FoundingDepositCTA client:load />
        </div>
      </div>
    </div>
  </section>

  <!-- PLAN TEASE -->
  <section id="pricing" class="mx-auto max-w-6xl px-6 pb-24">
    <div class="mb-10 max-w-2xl">
      <span class="eyebrow">{t(lang, "plans.eyebrow")}</span>
      <h2 class="heading mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
        {t(lang, "plans.title")}
      </h2>
      <p class="muted-text mt-3 text-sm">{t(lang, "plans.subtitle")}</p>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {plans.map((plan) => (
        <div
          class={`panel flex flex-col p-6 ${plan.highlight ? "ring-1 ring-brand-400/40" : ""}`}
        >
          {plan.highlight && (
            <span class="mb-3 inline-flex w-fit items-center rounded-full bg-brand-400/15 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wider text-brand-600 dark:text-brand-300">
              {t(lang, "plans.popular")}
            </span>
          )}
          <div class="heading text-sm font-semibold">{plan.name}</div>
          <div class="muted-text mt-1 text-xs">{t(lang, plan.whoKey)}</div>
          <div class="mt-5 flex items-baseline gap-1">
            <span class="heading text-3xl font-bold">{plan.price}</span>
            <span class="muted-text text-xs">
              {plan.isEnterprise ? plan.priceNote : "/mo"}
            </span>
          </div>
          <ul class="body-text mt-5 flex-1 space-y-2 text-sm">
            {plan.features.map((f) => (
              <li class="flex items-start gap-2">
                <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-brand-500 dark:bg-brand-400" />
                {f}
              </li>
            ))}
          </ul>
          {plan.isEnterprise && (
            <a
              href="#enterprise-cta"
              class="mt-5 inline-flex w-full items-center justify-center rounded-md border border-brand-500/40 bg-brand-500/[0.08] px-3 py-2 text-xs font-semibold text-brand-700 transition hover:bg-brand-500/[0.14] dark:text-brand-200"
            >
              {t(lang, "plans.enterprise.cta")}
            </a>
          )}
        </div>
      ))}
    </div>
  </section>

  <!-- ENTERPRISE -->
  <section id="enterprise" class="mx-auto max-w-6xl px-6 pb-24">
    <div class="mb-10 max-w-3xl">
      <span class="eyebrow">{t(lang, "enterprise.eyebrow")}</span>
      <h2 class="heading mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
        {t(lang, "enterprise.title.before")}
        <span class="text-gradient-brand">
          {t(lang, "enterprise.title.accent")}
        </span>
      </h2>
      <p class="body-text mt-4 text-base leading-relaxed">
        {t(lang, "enterprise.subtitle")}
      </p>
    </div>
    <div class="grid gap-4 lg:grid-cols-3">
      {enterpriseCards.map((card) => (
        <div class="panel flex flex-col p-6">
          <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-brand-500/10 text-brand-600 dark:text-brand-300">
            {card.icon === "shield" && (
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path
                  d="M12 3 4 6v6c0 4.5 3.4 8.5 8 9 4.6-.5 8-4.5 8-9V6l-8-3Z"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linejoin="round"
                />
                <path
                  d="m9 12 2 2 4-4"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            )}
            {card.icon === "support" && (
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path
                  d="M21 11.5a8.5 8.5 0 1 0-3.5 6.9l3.5.6-1-3.4A8.5 8.5 0 0 0 21 11.5Z"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linejoin="round"
                />
                <circle cx="8.5" cy="11.5" r="1" fill="currentColor" />
                <circle cx="12" cy="11.5" r="1" fill="currentColor" />
                <circle cx="15.5" cy="11.5" r="1" fill="currentColor" />
              </svg>
            )}
            {card.icon === "integration" && (
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path
                  d="M9 7V4h6v3M9 17v3h6v-3M4 12h3m10 0h3M7 7l3 3m4 4 3 3M17 7l-3 3m-4 4-3 3"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            )}
          </div>
          <h3 class="heading text-base font-semibold">{t(lang, card.titleKey)}</h3>
          <p class="muted-text mt-2 text-sm leading-relaxed">
            {t(lang, card.bodyKey)}
          </p>
        </div>
      ))}
    </div>

    <!-- Enterprise CTA -->
    <div
      id="enterprise-cta"
      class="mt-10 flex flex-col items-start justify-between gap-6 rounded-3xl border p-8 sm:flex-row sm:items-center lg:p-10"
      style="border-color: rgba(167,139,250,0.25); background: linear-gradient(135deg, rgba(139,92,246,0.08), rgba(196,181,253,0.02));"
    >
      <div class="max-w-xl">
        <h3 class="heading text-xl font-bold sm:text-2xl">
          {t(lang, "enterprise.cta.title")}
        </h3>
        <p class="muted-text mt-2 text-sm">
          {t(lang, "enterprise.cta.subtitle")}
        </p>
      </div>
      <a
        href="mailto:sales@skerry.cloud?subject=Enterprise%20inquiry"
        class="inline-flex shrink-0 items-center gap-2 rounded-full bg-brand-gradient px-5 py-3 text-sm font-semibold text-ink-900 shadow-[0_0_28px_-6px_rgba(167,139,250,0.7)] transition hover:scale-[1.03]"
      >
        {t(lang, "enterprise.cta.button")}
      </a>
    </div>
  </section>

  <!-- TRUST -->
  <section class="mx-auto max-w-6xl px-6 pb-24">
    <div class="text-center">
      <span class="eyebrow">{t(lang, "trust.eyebrow")}</span>
      <h2
        class="heading mt-3 text-2xl font-bold tracking-tight sm:text-3xl"
      >
        {t(lang, "trust.title")}
      </h2>
    </div>
    <div
      class="mt-8 grid grid-cols-2 items-center justify-items-center gap-6 sm:grid-cols-3 lg:grid-cols-6"
      style="filter: grayscale(1); opacity: 0.55;"
    >
      {Array.from({ length: 6 }).map(() => (
        <div
          class="flex h-10 w-full items-center justify-center rounded-md border text-[10px] font-semibold uppercase tracking-[0.2em]"
          style="border-color: var(--border); color: var(--fg-muted);"
        >
          YOUR LOGO
        </div>
      ))}
    </div>
    <p class="muted-text mx-auto mt-6 max-w-2xl text-center text-xs italic">
      {t(lang, "trust.placeholder")}
    </p>
  </section>

  <!-- FAQ -->
  <section id="faq" class="mx-auto max-w-3xl px-6 pb-24">
    <div class="mb-10">
      <span class="eyebrow">{t(lang, "faq.eyebrow")}</span>
      <h2 class="heading mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
        {t(lang, "faq.title")}
      </h2>
    </div>
    <div class="space-y-3">
      {faqItems.map((item) => (
        <details class="panel group p-5 transition">
          <summary class="heading flex cursor-pointer list-none items-center justify-between text-sm font-semibold">
            {t(lang, item.qKey)}
            <span class="ml-4 text-brand-500 transition group-open:rotate-45 dark:text-brand-400">
              +
            </span>
          </summary>
          <p class="muted-text mt-3 text-sm leading-relaxed">
            {t(lang, item.aKey)}
          </p>
        </details>
      ))}
    </div>
  </section>

  <!-- BOTTOM CTA -->
  <section class="mx-auto max-w-4xl px-6 pb-24">
    <div class="panel p-8 text-center lg:p-12">
      <h2 class="heading text-2xl font-bold tracking-tight sm:text-3xl">
        {t(lang, "bottom.title")}
      </h2>
      <p class="muted-text mx-auto mt-3 max-w-xl text-sm">
        {t(lang, "bottom.subtitle")}
      </p>
      <div class="mx-auto mt-6 max-w-md">
        <WaitlistForm
          client:load
          variant="primary"
          ctaLabel={t(lang, "form.submit")}
          placeholder={t(lang, "form.placeholder")}
          successCopyNew={t(lang, "form.success.copy.new")}
          successCopyDup={t(lang, "form.success.copy.dup")}
          successTitle={t(lang, "form.success.title")}
          successCta={t(lang, "form.success.cta")}
          successNote={t(lang, "form.success.note")}
          errorGeneric={t(lang, "form.error.generic")}
        />
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="border-t" style="border-color: var(--border);">
    <div
      class="muted-text mx-auto flex max-w-6xl flex-col gap-4 px-6 py-8 text-xs sm:flex-row sm:items-center sm:justify-between"
    >
      <div>© {new Date().getFullYear()} Skerry · {t(lang, "footer.tagline")}</div>
      <div class="flex gap-5">
        <a href="/privacy" class="hover:[color:var(--fg)]">
          {t(lang, "footer.privacy")}
        </a>
        <a href="/terms" class="hover:[color:var(--fg)]">
          {t(lang, "footer.terms")}
        </a>
        <a href="mailto:hello@skerry.cloud" class="hover:[color:var(--fg)]">
          hello@skerry.cloud
        </a>
      </div>
    </div>
  </footer>
</Layout>
