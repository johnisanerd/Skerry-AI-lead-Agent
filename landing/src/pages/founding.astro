---
import Layout from "@/layouts/Layout.astro";
import FoundingDepositCTA from "@/components/FoundingDepositCTA.tsx";

const url = new URL(Astro.request.url);
const email = url.searchParams.get("email") ?? "";
---

<Layout
  title="Founding spot — Skerry"
  description="Lock 50% off Skerry for life with a refundable €19 deposit. First 100 customers only."
  canonicalPath="/founding"
>
  <main class="mx-auto flex min-h-screen max-w-2xl flex-col justify-center px-6 py-16">
    <a href="/" class="mb-8 text-xs text-slate-500 hover:text-slate-300">
      ← Back to skerry.cloud
    </a>
    <span class="eyebrow">Founding spot · Limited to 100</span>
    <h1
      class="mt-4 text-4xl font-semibold tracking-tight text-white sm:text-5xl"
    >
      <span class="text-gradient-brand">€19</span> locks 50% off for life.
    </h1>
    <p class="mt-5 text-base text-slate-300">
      Refundable any time before launch. Charged once via Stripe. Applied as
      credit on your first invoice when we go live. No subscription starts here.
    </p>

    <div class="panel mt-10 p-6 sm:p-8">
      <FoundingDepositCTA client:load defaultEmail={email} />
    </div>

    <div class="mt-10 grid gap-4 sm:grid-cols-2">
      <div class="rounded-xl border border-white/5 p-4">
        <div class="text-xs uppercase tracking-wider text-brand-300/80">
          What you get
        </div>
        <ul class="mt-3 space-y-2 text-sm text-slate-300">
          <li>50% off any plan, locked for life</li>
          <li>Beta access ≥ 2 weeks before public</li>
          <li>Direct line to the founder</li>
        </ul>
      </div>
      <div class="rounded-xl border border-white/5 p-4">
        <div class="text-xs uppercase tracking-wider text-brand-300/80">
          What's not happening
        </div>
        <ul class="mt-3 space-y-2 text-sm text-slate-300">
          <li>No subscription starts</li>
          <li>No recurring charge</li>
          <li>No upsell traps — refund any time</li>
        </ul>
      </div>
    </div>
  </main>
</Layout>
