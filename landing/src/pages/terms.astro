---
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Terms — Skerry"
  description="Terms for the Skerry waitlist + founding deposit."
  canonicalPath="/terms"
>
  <main class="mx-auto max-w-3xl px-6 py-20">
    <a href="/" class="text-xs text-slate-500 hover:text-slate-300">← Back</a>
    <h1 class="mt-6 text-3xl font-semibold tracking-tight text-white">Terms</h1>
    <p class="mt-3 text-xs text-slate-500">Last updated: 2026-05-09</p>

    <div class="prose prose-invert mt-8 max-w-none text-slate-300">
      <p>
        Placeholder until the full ToS is live. These terms cover the waitlist
        + founding-deposit period only; full SaaS terms ship at launch.
      </p>

      <h2 class="text-white">The €19 founding deposit</h2>
      <ul>
        <li>One-time charge, processed by Stripe.</li>
        <li>Locks 50% off any Skerry plan, for the lifetime of your subscription.</li>
        <li>
          Refundable in full at any time before public launch. Email
          <a href="mailto:hello@skerry.cloud" class="text-brand-300">hello@skerry.cloud</a>
          with "refund" — we process within 7 days.
        </li>
        <li>
          On launch day, the €19 is automatically applied as credit on your
          first invoice. The deposit itself is not a subscription.
        </li>
      </ul>

      <h2 class="text-white">No service yet</h2>
      <p>
        The Skerry product is in private beta. We do not guarantee a specific
        launch date. If we cancel the project, all deposits are refunded
        automatically.
      </p>

      <h2 class="text-white">Contact</h2>
      <p>
        <a href="mailto:hello@skerry.cloud" class="text-brand-300">hello@skerry.cloud</a>
      </p>
    </div>
  </main>
</Layout>
