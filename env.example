# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3001

# Required: min 32 chars. Used to sign session cookies.
SESSION_SECRET=

# Demo accounts (solo@skerry.io / solo123, etc.). Never enable in production.
ALLOW_DEMO_AUTH=true

# Comma-separated browser origins allowed to call the API with credentials.
# Required when NODE_ENV=production.
# SKERRY_ALLOWED_ORIGINS=https://your-app.example.com

# Postgres for monthly run entitlements (optional locally; required for real usage limits).
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# Production: TLS to server; set DATABASE_SSL_REJECT_UNAUTHORIZED=false only if your provider needs it.
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

RESEND_API_KEY=
NEVERBOUNCE_API_KEY=

# Apollo.io (empfohlen — kostenlos, legal, DSGVO-konform)
# Registrierung: https://app.apollo.io/settings/integrations/api
# Free Plan: bis zu 10.000 Email-Credits/Monat mit Corporate Domain
APOLLO_API_KEY=

# Apify (alternative Discovery, Grauzone LinkedIn-Scraping — optional)
APIFY_API_KEY=
# APIFY_LEADS_ACTOR_ID=curious_coder~linkedin-people-search

SKERRY_FROM_EMAIL=Skerry <onboarding@resend.dev>

PROVIDER_TIMEOUT_MS=12000
PROVIDER_RETRIES=2

# Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_AGENCY=
PUBLIC_APP_URL=http://localhost:3000

# Client dev: point SPA at API (Vite). Leave unset in production (same origin).
# VITE_API_BASE=http://localhost:3001
