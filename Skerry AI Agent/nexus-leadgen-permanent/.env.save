# ─── Client (Vite) — only publishable keys ───────────────────────────────────
VITE_API_BASE=http://localhost:3001
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Comma-separated emails that see the developer integrations panel in the UI
VITE_DEVELOPER_EMAILS=dev@skerry.io

# Optional legacy debugging only — do NOT use in production for OpenAI/Apify secrets
# VITE_OPENAI_API_KEY=

# ─── API server (never VITE_ prefix) ─────────────────────────────────────────
PORT=3001
NODE_ENV=development

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=
RESEND_API_KEY=
NEVERBOUNCE_API_KEY=
SKERRY_FROM_EMAIL=Skerry <hello@your-domain.com>

# Apify lead discovery (optional; requires actor that accepts generic input)
FEATURE_APIFY_LEADS=false
APIFY_API_KEY=
APIFY_LEADS_ACTOR_ID=

# Demo API auth: client sends Authorization: Bearer demo
SKERRY_ALLOW_DEMO_AUTH=true

PUBLIC_APP_URL=http://lo=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_AGENCY=
